APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

# Dump local SISEES (solo lectura). Restaurar catálogos en BD sisees_legacy — nunca producción.
SICEES_LEGACY_HOST=127.0.0.1
SICEES_LEGACY_PORT=3306
SICEES_LEGACY_DATABASE=sisees_legacy
SICEES_LEGACY_USERNAME=root
SICEES_LEGACY_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Integración Control Escolar (MySQL lectura)
CONTROL_ESCOLAR_ENABLED=false
CONTROL_ESCOLAR_CONNECTION=control_escolar
CONTROL_ESCOLAR_DRIVER=mysql
CONTROL_ESCOLAR_HOST=127.0.0.1
CONTROL_ESCOLAR_PORT=3306
CONTROL_ESCOLAR_DATABASE=
CONTROL_ESCOLAR_USERNAME=root
CONTROL_ESCOLAR_PASSWORD=
CONTROL_ESCOLAR_READ_ONLY=true
CONTROL_ESCOLAR_TIMEOUT=10
CONTROL_ESCOLAR_ENCODING=UTF-8

# Informix legacy (shadow para servicio 34)
INFORMIX_ENABLED=false
INFORMIX_WRITE_ENABLED=false
INFORMIX_CONNECTION=informix_legacy
INFORMIX_DRIVER=informix
INFORMIX_HOST=
INFORMIX_SERVICE=
INFORMIX_DATABASE=
INFORMIX_SERVER=
INFORMIX_USERNAME=
INFORMIX_PASSWORD=
INFORMIX_TIMEOUT=15
INFORMIX_TABLE_CERT=e11superior_cert
INFORMIX_TABLE_MATERIAS=e11materias_cert

# Puente consulta SICES legacy (solo lectura — Informix)
SICES_LEGACY_ENABLED=false
SICES_LEGACY_CONNECTION=informix_sices
SICES_LEGACY_READ_ONLY=true
SICES_LEGACY_WRITE_ENABLED=false
SICES_LEGACY_SHADOW_ENABLED=false
SICES_LEGACY_TIMEOUT=10
SICES_LEGACY_ENCODING=ISO-8859-1
SICES_LEGACY_BASE_URL=
SICES_LEGACY_CONSULTA_SEP_URL=https://www.seiem.gob.mx/certificados/index.php
SICES_LEGACY_DRIVER=
SICES_LEGACY_HOST=
SICES_LEGACY_SERVICE=
SICES_LEGACY_DATABASE=
SICES_LEGACY_SERVER=
SICES_LEGACY_USERNAME=
SICES_LEGACY_PASSWORD=

# Firma SEP/SINCE servicio 34 (multipart: urlshort + prod únicamente)
SINCE_FIRMA_ENABLED=false
SINCE_FIRMA_SIMULATED=false
SINCE_FIRMA_ENV=dev
SINCE_FIRMA_PROD_URL=http://10.15.10.34:9090/since-service/servicios/firma/certificado/normales/firma
SINCE_FIRMA_DEV_URL=http://10.15.10.38:9090/since-service/servicios/firma/certificado/normales/firma
SINCE_FIRMA_TIMEOUT=120
SINCE_FIRMA_CONNECT_TIMEOUT=10
SINCE_FIRMA_PROD_FLAG=1

# Writeback opcional Informix tras firma exitosa (oxml_sep, folio, sello, osituac=F)
SICES_LEGACY_WRITEBACK_ENABLED=false

# Generación PDF (modo simulado por defecto; sin Jasper productivo).
PDF_GENERATION_ENABLED=true
PDF_GENERATION_SIMULADA=true
PDF_DEFAULT_ENGINE=jasper
JASPER_ENABLED=false
JASPER_BASE_PATH=
JASPER_TIMEOUT=60
